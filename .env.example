# Optional. Only needed for Companies House enrichment.
COMPANIES_HOUSE_API_KEY=

# SQLite database location. Relative paths resolve from the project directory.
FIA_DB_PATH=data/fia.sqlite3

# User-Agent sent to public sources. Include a real project contact before production use.
FIA_USER_AGENT=ForgottenAssetIntelligence/0.2 (+contact@example.com)

# USPTO Open Data Portal (account/API-key gated as of 2026)
USPTO_API_KEY=

# v1.0 scheduler defaults are CLI-configurable; external APIs are never called unless --execute is supplied.
# Companies House API key is required for automatic Companies House research.

# Separate key registered for the Companies House Streaming API
COMPANIES_HOUSE_STREAM_KEY=

# Required for automated U.S. Data.gov Catalog API v4 mining
DATA_GOV_API_KEY=

# v1.5 GPT Action API
# Generate a strong random value, e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`
FIA_AGENT_API_KEY=
# Set to the public HTTPS origin after deployment, e.g. https://vestra.example.com
FIA_PUBLIC_BASE_URL=
